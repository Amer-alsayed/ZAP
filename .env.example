# ==========================================
# ZAP Environment Configuration
# ==========================================

# Runtime environment (development | production)
NODE_ENV=development

# Server Port
PORT=5000

# JWT Authentication Secret (Generate a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration
# Leave DATABASE_URL empty or unset to use local SQLite WAL (zap.db)
# Set to a PostgreSQL connection URI for production (e.g. Neon, Supabase, RDS)
# DATABASE_URL=postgresql://user:password@host:5432/zap_db?sslmode=require

# SQLite database file path (used when DATABASE_URL is not provided)
DATABASE_PATH=../../zap.db

# CORS Origin (comma-separated list of allowed origins, or leave empty for same-origin)
# CLIENT_ORIGIN=http://localhost:5173

# Encrypted Media Time-To-Live in hours (default: 168 hours = 7 days)
MEDIA_TTL_HOURS=168

# Optional: Coturn STUN/TURN Server Relay Credentials
# TURN_SECRET=your_turn_static_auth_secret
# TURN_HOSTS=stun:yourdomain.com:3478,turn:yourdomain.com:3478
